<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- عنوان التطبيق أو اللوحة -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="HUD Control Panel"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- زر تشغيل الرادار -->
    <Button
        android:id="@+id/btnLaunchPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#4CAF50"
        android:padding="12dp"
        android:text="تشغيل الرادار"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

    <!-- زر إيقاف الرادار -->
    <Button
        android:id="@+id/btnStopPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#F44336"
        android:padding="12dp"
        android:text="إيقاف الرادار"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

    <!-- زر وضع Normal -->
    <Button
        android:id="@+id/btnModeNormal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#2196F3"
        android:padding="12dp"
        android:text="Normal Mode"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

    <!-- زر Kernel -->
    <Button
        android:id="@+id/btnModeTurbo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#FF9800"
        android:padding="12dp"
        android:text="Kernel"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

    <!-- مستطيل عرض نوع ورقم الكيرنل -->
    <TextView
        android:id="@+id/tvKernelVersion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="#1E1E1E"
        android:gravity="center"
        android:padding="14dp"
        android:text="نوع ورقم الكيرنل سيظهر هنا"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- سويتش الصلاحيات -->
    <Switch
        android:id="@+id/switchPermission"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="منح الصلاحيات اللازمة"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

</LinearLayout>
