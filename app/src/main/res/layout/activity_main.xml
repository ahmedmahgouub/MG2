<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp"
    android:background="#121212">

    <!-- مكان عرض كلمة محجوب وتتغير لأول 5 أرقام من الكيرنال باللون البرتقالي الغامق عند الضغط -->
    <TextView
        android:id="@+id/tvMahgoub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="محجوب"
        android:textSize="14sp"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnLaunchPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="تشغيل الرادار"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnStopPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="إيقاف الرادار"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnModeNormal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Normal"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnModeTurbo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Kernel"
        android:layout_marginBottom="12dp"/>

    <Switch
        android:id="@+id/switchPermission"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="تفعيل الصلاحيات"
        android:textColor="#FFFFFF"/>

</LinearLayout>
